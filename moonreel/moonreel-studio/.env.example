# MoonReel Studio configuration. Copy to .env and fill in MUSE2API_KEY.

# PostgreSQL started by `docker compose up -d` (see docker-compose.yml).
DATABASE_URL=postgres://moonreel:moonreel@localhost:5434/moonreel

# Shared secret protecting muse2api's admin page and API. You choose it; it is not issued by Muse.
# Generate one with: openssl rand -hex 32
# Read by both docker compose and the app.
MUSE2API_KEY=change-me-to-a-long-random-string

# Where the app reaches muse2api.
MUSE2API_BASE_URL=http://localhost:18610

# Scenes sent to Muse in parallel (1-4). muse2api drives a single browser, so keep 1.
MUSE_CONCURRENCY=1

# Generated images and videos. Defaults to ~/.moonreel/storage.
# Keep it OUTSIDE the project folder, otherwise `next dev` reloads the page on every new file.
# STORAGE_DIR=/absolute/path/outside/the/repo

ELEVENLABS_API_KEY=
# Optional public Studio gate; set BOTH to enable. Required by the Render entrypoint.
# STUDIO_ACCESS_USER=admin
# STUDIO_ACCESS_PASSWORD=choose-a-new-long-password

# Optional AI Gateway (omit unused URL variables rather than leaving them empty).
# CF_AIG_BASE_URL=https://gateway.ai.cloudflare.com/v1/your-account/your-gateway/compat
# CF_AIG_ACCOUNT_ID=your-account
# CF_AIG_GATEWAY_ID=your-gateway
# CF_AIG_TOKEN=your-secret-in-environment-only
# CF_AIG_PROVIDER_KEY=your-secret-in-environment-only
# CF_AIG_BYOK_ALIAS=your-key-alias
# SCRIPT_MODEL=deepseek/deepseek-chat
